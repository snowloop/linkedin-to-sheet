{
  "name": "linkedin-to-sheet",
  "private": true,
  "version": "1.2.3",
  "description": "Firefox extension that sends company info from LinkedIn company pages and websites to a Google Sheet.",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:chrome": "wxt",
    "build": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@webext-core/messaging": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
