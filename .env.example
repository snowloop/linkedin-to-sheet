# Copy to .env.firefox and .env.chrome (git-ignored). WXT loads the file that
# matches the target browser, so each build gets its own OAuth client:
#   .env.firefox -> "Desktop app" client      (pnpm build / pnpm zip)
#   .env.chrome  -> "Web application" client  (pnpm build:chrome / pnpm zip:chrome)
WXT_GOOGLE_CLIENT_ID=
WXT_GOOGLE_CLIENT_SECRET=
